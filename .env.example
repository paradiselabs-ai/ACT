# ACT environment variables
# Copy to .env at the repo root. Most users only need to set API keys here OR in ~/.act.json.
# ~/.act.json takes precedence — keys here are a fallback.

# ── Server ──────────────────────────────────────────────────────────────────
# ACT_SERVER_URL=http://localhost:8080
# PORT=8080

# ── Agent CLI override (advanced) ───────────────────────────────────────────
# AGENT_CLI=./act-agent/act-agent

# ── LLM provider keys (only set the ones you'll use) ────────────────────────
# Prefer setting these in ~/.act.json under "providers" — that's the canonical place.
# These env vars exist as a fallback for legacy code paths.

# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# ── Local model server (optional — Ollama / LM Studio / vLLM) ───────────────
# LOCAL_ENDPOINT=http://localhost:11434

# ── Dev / debug ─────────────────────────────────────────────────────────────
# ACT_DEV_DEBUG=true   # writes timing logs to file (stderr is eaten by altscreen)
