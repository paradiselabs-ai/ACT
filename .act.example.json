{
  "$schema": "./act-agent/act-schema.json",

  "providers": {
    "anthropic": { "apiKey": "", "disabled": false },
    "openai": { "apiKey": "", "disabled": true },
    "groq": { "apiKey": "", "disabled": true },
    "openrouter": { "apiKey": "", "disabled": true }
  },

  "agents": {
    "coder": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000,
      "reasoningEffort": "medium"
    },

    "planner": {
      "model": "claude-opus-4-20250514",
      "maxTokens": 8000
    },
    "observer": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 2000
    },
    "assurance": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000
    },
    "qa_synthesizer": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000
    },

    "frontend_dev": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000,
      "backend": "act-agent"
    },
    "backend_dev": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000,
      "backend": "act-agent"
    },
    "qa_engineer": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000,
      "backend": "act-agent"
    },
    "researcher": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000,
      "backend": "act-agent"
    },
    "developer": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000,
      "backend": "act-agent"
    },

    "summarizer": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000
    },
    "task": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 5000
    },
    "title": {
      "model": "claude-sonnet-4-20250514",
      "maxTokens": 80
    }
  },

  "contextPaths": [
    "CLAUDE.md"
  ]
}
