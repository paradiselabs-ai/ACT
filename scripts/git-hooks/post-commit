#!/bin/sh
# Freshness staler — flips artifacts to "stale" in docs/constitution/freshness.json
# when a commit touches their watched code paths, and triggers the auto-refresh
# loop for artifacts that opt in (auto_refresh: true). Staling itself is zero
# tokens; the spawned refresh session is debounced + locked (freshness-autorefresh.sh).
# Canonical copy: scripts/git-hooks/post-commit (installed via scripts/install-hooks.sh).
# Rules: docs/constitution/UPDATE_LOOPS.md

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 0
REGISTRY="$REPO_ROOT/docs/constitution/freshness.json"
[ -f "$REGISTRY" ] || exit 0
command -v python3 >/dev/null 2>&1 || { echo "freshness: python3 missing, staling skipped" >&2; exit 0; }

# -m --first-parent: on merge commits, diff against the first parent so the files a
# feature branch brings in DO stale artifacts (plain diff-tree emits nothing on merges
# — review-plan-2026-06-11 C2). On ordinary commits this is identical to the plain form.
STALED="$(git diff-tree --no-commit-id --name-only -r -m --first-parent HEAD | python3 -c '
import json, sys

registry_path, commit = sys.argv[1], sys.argv[2]
changed = [l.strip() for l in sys.stdin if l.strip()]
if not changed:
    sys.exit(0)

with open(registry_path) as f:
    reg = json.load(f)

dirty = False
for name, art in reg.get("artifacts", {}).items():
    own = art.get("paths", [])
    watch = art.get("watch", [])
    touched_watch = any(c.startswith(w) for c in changed for w in watch)
    touched_self = any(c == p for c in changed for p in own)
    # A commit that touches watched code but NOT the artifact itself stales it.
    # (A combined artifact+watch commit is trusted as a refresh — accepted failure
    # mode, UPDATE_LOOPS §5; the pre-merge gate is the backstop.)
    if touched_watch and not touched_self and art.get("status") != "stale":
        art["status"] = "stale"
        art["staled_by"] = commit
        dirty = True
        print(f"freshness: {name!r} is now STALE (commit {commit} touched watched paths)", file=sys.stderr)
        if art.get("auto_refresh"):
            print(name)  # stdout = machine channel for the auto-refresh trigger

if dirty:
    with open(registry_path, "w") as f:
        json.dump(reg, f, indent=2)
        f.write("\n")
' "$REGISTRY" "$(git rev-parse --short HEAD)")"

# Fresh->stale transitions on auto_refresh artifacts spawn the refresh session
# (debounced + locked inside the script; ACT_NO_AUTOREFRESH=1 disables).
for name in $STALED; do
  "$REPO_ROOT/scripts/freshness-autorefresh.sh" "$name" || true
done
exit 0
