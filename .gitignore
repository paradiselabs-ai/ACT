# ─────────────────────────────────────────────
# ACT — .gitignore
# ─────────────────────────────────────────────

# ── Agent/AI context files ──────────────────
*.md~
*.md.bak
openmemory.md
.claude_project

# ── AI chat exports & internal discussion files ──
*.txt
!LICENSE.txt
ACT_DEMO_LOGS.md
WINDSURF_ACT_GUIDANCE.md
*_DEMO_*.md
*longtermmemory*
*discussion*
*-prompt*
*instance*

# ── Coordination files (runtime / internal) ──
act-coordination-*.json
coordination-*.json
*.coordination
server/data/
!act-coordination.json

# ── Test files ──────────────────────────────
test_*.py
test_*.js
*_test.py
*_test.js
.test/
.pytest_cache/
.coverage
htmlcov/
.nyc_output/
coverage/
TESTING_STRATEGY.md
SETUP.md

# ── Personal scratch / notes ────────────────
taskade agentics.md
*.md
!README.md
!CLAUDE.md
!AGENTS.md
!docs/**/*.md
!nestty/*.md
!tests/*.md
!.windsurf/**/*.md

# ── Python environment ───────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv
ENV/
env/
.Python
*.egg-info/
*.egg
pip-log.txt

# ── Node.js ─────────────────────────────────
node_modules/
package-lock.json
npm-debug.log
yarn-error.log

# ── Build artifacts ──────────────────────────
dist/
build/
*.tsbuildinfo
.next/
out/

# ── Logs ─────────────────────────────────────
logs/
*.log
lerna-debug.log*

# ── Secrets & credentials ────────────────────
.env
.env.local
.env.*.local
secrets/
*.key
*.pem
credentials.json
api_keys.json

# ── Database / vector store ──────────────────
*.sqlite
*.sqlite3
*.db
qdrant_storage/
qdrant_snapshots/
milvus_data/

# ── IDE & editor ─────────────────────────────
.vscode/
.idea/
.claude/
.windsurf/
.qodo/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
.cache/
.eslintcache

# ── OS ───────────────────────────────────────
.DS_Store
Thumbs.db
.Windows-thumbnail.db

# ── Docker ───────────────────────────────────
.docker/
docker-compose.override.yml

# ── Misc ─────────────────────────────────────
tmp/
temp/
.tmp/
requirements.txt
sdk/

# OpenMemory - IDE/Assistant specific rules
.windsurf/rules/openmemory.md

# NOMIK
docker/data/
docker/logs/
pub/
.bin/
**/*.tscom

# ── Compiled binaries ────────────────────────
act-agent/act-agent
interact/interact

# ── Obsidian Vault (large plugins/caches) ────
docs/Vault/

# ── Skills lock file ─────────────────────────
skills-lock.json

# ── Tool-generated state ─────────────────────
.manifests/
.nomik/
**/.nomik/
.tmp


# ── ACT runtime state (per-project sqlite + sessions) ─
# Note: act-agent/.act.json is intentionally tracked (LSP config, no secrets).
# The user-level config lives at ~/.act.json (outside the repo).
.act/
**/.act/

# ── Test project run outputs (Snake Arena, etc) ─────
# Tracked: tests/quick-start.sh, tests/smoke-test.sh
# Ignored: anything generated by an interactive swarm run
tests/__pycache__/
tests/*.py
tests/snake*/
tests/game*.py
tests/nomik.config.ts
tests/README.md

# ── Misc tooling state ──────────────────────
docs-assembler-config.json
.DS_Store
github.comparadiselabs-ai-act-tree-nestty.md

CLAUDE.md
