#!/usr/bin/env node

/**
 * ACT CLI Entry Point
 *
 * Routes to either:
 * - Agent CLI (act context, act task, act files, act graph, etc.) — for headless agents
 * - REPL (act with no args, or act server) — for human operators
 */

// Known agent CLI commands (routed to act-cli)
const AGENT_COMMANDS = new Set([
  'context', 'task', 'brief', 'files', 'message', 'log', 'graph'
]);

const command = process.argv[2];

if (command && AGENT_COMMANDS.has(command)) {
  // Agent CLI mode — dynamically import the agent CLI
  import('../dist/act-cli.js').catch(() => {
    // Fallback: try tsx for development
    import('child_process').then(({ execFileSync }) => {
      try {
        execFileSync('npx', ['tsx', require('path').join(__dirname, '..', 'act-cli.ts'), ...process.argv.slice(2)], { stdio: 'inherit' });
      } catch (e) {
        process.exit(e.status || 1);
      }
    });
  });
} else if (command === 'server') {
  const subCommand = process.argv[3];
  if (subCommand === 'start') {
    console.log('Starting ACT server...');
    console.log('Run: cd server && npm run dev');
    process.exit(0);
  } else {
    console.log('Usage: act server start|stop');
    process.exit(1);
  }
} else {
  // REPL mode — interactive terminal
  import('../dist/act-repl.js').then(({ ACTRepl }) => {
    const serverUrl = process.env.ACT_SERVER_URL || 'http://localhost:8080';
    const repl = new ACTRepl(serverUrl);
    repl.start().catch(error => {
      console.error('Failed to start ACT REPL:', error);
      process.exit(1);
    });
  }).catch(err => {
    console.error('Failed to load ACT REPL. Run `npm run build` in cli/ first.');
    console.error(err.message);
    process.exit(1);
  });
}
